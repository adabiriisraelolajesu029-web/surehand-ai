# Copy to .env and fill in. NEVER commit .env and never put these in frontend code.
PORT=8787
# Origin(s) allowed to call this API (comma separated). Not needed when the backend serves the frontend itself.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Football statistics provider. Supported: football-data (football-data.org, free tier works) or api-football (paid plan needed for the current season).
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
# Leagues to cover. football-data codes: PL (Premier League), PD (La Liga), SA (Serie A), BL1 (Bundesliga), FL1 (Ligue 1), CL (Champions League).
# (API-Football numeric ids 39,140,135,78,61 are also accepted.) "all" is not available on the free tier.
FOOTBALL_LEAGUE_IDS=PL,PD,SA,BL1,FL1,CL

# Anthropic Claude API (prediction reasoning)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Protects write/cron endpoints (lock predictions, sync results, run daily analysis). Use a long random string.
ADMIN_TOKEN=
